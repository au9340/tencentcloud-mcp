# ---- HTTP ----
PORT=8787
HOST=0.0.0.0
MCP_PATH=/mcp

# ---- 执行引擎 ----
# api = 自己实现 TC3-HMAC-SHA256 签名，直接打 https://<service>.tencentcloudapi.com
# sdk = 走官方 tencentcloud-sdk-nodejs（需额外 npm i tencentcloud-sdk-nodejs）
TENCENT_MCP_ENGINE=api

# ---- 默认参数 ----
TENCENT_MCP_DEFAULT_REGION=ap-guangzhou
TENCENT_MCP_MAX_REQUESTS=20
TENCENT_MCP_TIMEOUT_MS=20000
# 高危写操作要求模型显式传 confirm: true
TENCENT_MCP_REQUIRE_CONFIRM=false

# ---- 服务端凭据（可选：也可以用 Authorization: Bearer <secretId>:<secretKey> 按请求传入）----
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=
