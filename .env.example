# ---- 执行引擎 ----
# api = 自己实现 TC3-HMAC-SHA256 直连 https://<service>.tencentcloudapi.com（默认，零依赖）
# sdk = 官方 tencentcloud-sdk-python（需自行装包，SCF 上不推荐）
MCP_ENGINE=api

# ---- 默认参数 ----
MCP_DEFAULT_REGION=ap-guangzhou
MCP_MAX_REQUESTS=20
MCP_TIMEOUT_MS=20000
# 写/删类 Action 必须 confirm=True 才执行
MCP_REQUIRE_CONFIRM=0

# ---- 凭据 ----
# 默认只用“透传”：Authorization: Bearer <secretId>:<secretKey>[:<sessionToken>]
# 公网开放时千万不要设为 1，否则没带头的请求会烧你自己的账号。
MCP_ALLOW_ENV_CREDENTIALS=0
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=

LOG_LEVEL=INFO
